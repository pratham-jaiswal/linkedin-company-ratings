{
  "manifest_version": 2,
  "name": "LinkedIn Company Ratings",
  "version": "1.0",
  "description": "Shows Glassdoor and AmbitionBox ratings on LinkedIn job pages.",

  "content_scripts": [
    {
      "matches": [
        "*://www.linkedin.com/jobs/collections/*",
        "*://www.linkedin.com/jobs/search/*"
      ],
      "js": ["content.js", "utils.js"],
      "css": ["style.css"]
    }
  ],
  "permissions": ["*://www.glassdoor.com/*"]
}
