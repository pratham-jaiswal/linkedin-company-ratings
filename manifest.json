{
  "manifest_version": 2,
  "name": "LinkedIn Company Ratings",
  "version": "1.3.0",
  "description": "Shows company ratings from Glassdoor on LinkedIn job pages.",

  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": { "required": ["none"] }
    }
  },

  "permissions": ["*://*.linkedin.com/*", "*://*.glassdoor.com/*"],

  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/jobs/view/*",
        "*://*.linkedin.com/jobs/search*",
        "*://*.linkedin.com/jobs/collections/*",
        "*://*.linkedin.com/company/*",
        "*://*.linkedin.com/school/*"
      ],
      "js": ["utils.js", "content.js"],
      "css": ["style.css"]
    }
  ]
}
